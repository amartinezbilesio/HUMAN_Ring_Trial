# ===========================================================================
#  HUMAN Ring Trial — .gitignore
#
#  Rule of thumb: track everything a collaborator needs to render the
#  downstream analysis (Step 5) without re-running SIRIUS or xcms. Ignore
#  raw data, per-batch caches, and Quarto render artifacts.
# ===========================================================================

# ---- Raw vendor data (lab-specific, too large for git) --------------------
*.mzML
*.wiff
*.raw
*.d/
*.sqlite

# ---- Preprocessing intermediates (per-lab, regeneratable from raw) --------
**/HE_mzml/
1_preprocessing/*/HE/mzml/
1_preprocessing/*/HE/mse/
1_preprocessing/*/HE/mse2/
1_preprocessing/*/Others/mzml/
1_preprocessing/*/Others/mse/
1_preprocessing/*/Others/mse2/

# ---- SIRIUS per-batch / per-mixture caches (only used to skip work
#      when re-running SIRIUS; downstream consumes only the two
#      aggregated CSVs explicitly un-ignored below) -----------------------
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/*_batch*_*.csv
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/*_rt.csv
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/sirius_full_*_mix_*.csv
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/sirius_summary_*_mix_*.csv
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/sirius_full_all_labs_all_mixtures.csv
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/sirius_summary_all_labs_all_mixtures.csv
3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/extraction_counts_*.csv
*.sirius

# Canonical SIRIUS outputs consumed by Step 5 — explicitly tracked
!3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/annotation_chrom_metrics.csv
!3_annotation_manual/HE/3_Sirius_curation/results_all_ms2/annotation_identity.csv

# ---- Quarto/RMarkdown render artifacts ------------------------------------
*_files/
*_cache/
.quarto/
**/_freeze/
*.rmarkdown

# ---- R / RStudio ----------------------------------------------------------
.Rhistory
.Rproj.user/
*.Rproj
.RData
.Renviron

# ---- Oversized RData / RDS (>100 MB, exceed GitHub's per-file limit) ------
# These must be distributed out-of-band (Zenodo / lab cloud / Git LFS).
# Listed individually so smaller RData files in object/ are still tracked.
5_downstream_analysis/object/sp_full.RData
5_downstream_analysis/object/sp_full_detect.RData
5_downstream_analysis/object/sp_icl.RData
# Regeneratable matching caches — moderate size, costly only on the first
# render of 2_consensus_peaks.qmd. Excluded to keep the repo lighter.
5_downstream_analysis/object/correspondence_grouped.rds
5_downstream_analysis/object/correspondence_grouped_aligned.rds
5_downstream_analysis/object/correspondence_grouped_raw.rds

# ---- Editor / OS / temp ---------------------------------------------------
*.DS_Store
Thumbs.db
.nfs*
slurm-*.out
*.bak
*~
*.zip

# ---- Authentication / secrets --------------------------------------------
/auth
.env

# ---- Internal analysis docs (kept local, not for GitHub) -----------------
5_downstream_analysis/MANUSCRIPT_NOTES.md
5_downstream_analysis/CANONICAL_SCHEMAS.md
5_downstream_analysis/object/PRESENTATION_PROMPT.md
HUMAN_RingTrial_Presentation.zip

# ---- Tool metadata --------------------------------------------------------
.claude/

# ---- Legacy / orphaned paths (kept here so they don't reappear) -----------
/standard_mixes_prep
/example/
/example_lab/
/shared_data
/results/
/downstream_analysis/
redner.sh
